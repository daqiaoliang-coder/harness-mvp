{
  "name": "harness-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "concurrently -n gateway,loop-node -c cyan,green \"npm:dev:gw\" \"npm:dev:node\"",
    "dev:gw": "npm --workspace @harness/gateway run dev",
    "dev:node": "npm --workspace @harness/loop-node run dev",
    "start:gw": "npm --workspace @harness/gateway run start",
    "start:node": "npm --workspace @harness/loop-node run start",
    "test": "tsx --test packages/*/src/**/*.test.ts",
    "test:gw": "tsx --test packages/gateway/src/*.test.ts",
    "test:shared": "tsx --test packages/shared/src/*.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=20" }
}
