# ---------- Gateway ----------
HTTP_PORT=8787
WORKER_TOKEN=dev-token
PROJECT_ID=demo
DB_PATH=./data/events.db
PIPELINE=plan,code,test

# GitHub：留空则自动进入 mock 模式（内存 issue）
# GITHUB_MODE=real
# GITHUB_TOKEN=ghp_xxx
# GITHUB_OWNER=your-name
# GITHUB_REPO=your-repo
# GITHUB_POLL_MS=5000

# ---------- 飞书通知（可选，方案 A：群自定义机器人 webhook）----------
# 群设置 → 群机器人 → 添加「自定义机器人」→ 复制 webhook 地址
# 留空则关闭通知；不阻断启动
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 机器人安全设置勾选了「签名校验」时填写（推荐二选一：签名 或 关键词）
# FEISHU_WEBHOOK_SECRET=SECxxxxxxxx

# ---------- loop-node ----------
GATEWAY_URL=ws://localhost:8787/ws
NODE_ID=node-local-1
AGENTS=mock

# 换成真实 Agent CLI（示例）
# AGENT_CMD=/usr/local/bin/claude
# AGENT_ARGS=--print
