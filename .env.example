# ---------- Gateway ----------
HTTP_PORT=8787
WORKER_TOKEN=dev-token
PROJECT_ID=demo
DB_PATH=./data/events.db
PIPELINE=plan,code,test

# GitHub：留空则自动进入 mock 模式（内存 issue）
# GITHUB_MODE=real
# GITHUB_TOKEN=ghp_xxx
# GITHUB_OWNER=your-name
# GITHUB_REPO=your-repo
# GITHUB_POLL_MS=5000

# ---------- 飞书通知（可选，方案 A：群自定义机器人 webhook）----------
# 群设置 → 群机器人 → 添加「自定义机器人」→ 复制 webhook 地址
# 留空则关闭通知；不阻断启动
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 机器人安全设置勾选了「签名校验」时填写（推荐二选一：签名 或 关键词）
# FEISHU_WEBHOOK_SECRET=SECxxxxxxxx

# ---------- loop-node ----------
GATEWAY_URL=ws://localhost:8787/ws
NODE_ID=node-local-1
AGENTS=mock

# 换成真实 Agent CLI（示例）
# AGENT_CMD=/usr/local/bin/claude
# AGENT_ARGS=--print

# ---------- 前置检查加固（可选，真实环境建议开启）----------
# 基础检查（git / node / 网络可达性）恒定启用，无需配置。
# 以下三项按部署需要声明，未声明则不检查 —— mock 模式零配置可跑。
# BLOCKER 级失败时 agent 不启动、不消耗 token，直接按失败 run 回报。

# 凭证有效性：逗号分隔的环境变量名，逐个检查是否已设置
# PREFLIGHT_ENV_VARS=GITHUB_TOKEN

# 仓库访问权限：一次验证「凭证有效 + 仓库可达 + 有读权限」
# PREFLIGHT_GIT_REMOTE=https://github.com/your-name/your-repo.git

# agent CLI 登录态：自定义验证命令（按空白拆成 argv）
# PREFLIGHT_AGENT_LOGIN_CHECK=gh auth status

# ---------- 执行超时（可选）----------
# 单 run 总时长上限，0 表示禁用（默认 60min，兜底失控循环）
# RUN_TIMEOUT_MS=3600000
# agent 连续无输出的判定时长，0 表示禁用（默认 5min，识别卡死）
# RUN_IDLE_TIMEOUT_MS=300000
